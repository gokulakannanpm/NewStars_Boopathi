# EveHub Root Environment Variables Template
# Copy to .env or configure in your deployment platform (Vercel / Render)

# Frontend Configuration
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Configuration
PORT=8000
DATABASE_URL=sqlite:///./evehub.db
SECRET_KEY=change-this-in-production-to-a-secure-random-token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# External Services (Simulated or Live credentials)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
